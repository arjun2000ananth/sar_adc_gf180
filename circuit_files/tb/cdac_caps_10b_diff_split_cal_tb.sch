C {code_shown.sym} 100 -300 0 0 {name=MODELS only_toplevel=true
format="tcleval( @value )"
value="
.include $::env(PDK_ROOT)/$::env(PDK)/libs.tech/ngspice/design.ngspice
.lib $::env(PDK_ROOT)/$::env(PDK)/libs.tech/ngspice/sm141064.ngspice typical
.lib $::env(PDK_ROOT)/$::env(PDK)/libs.tech/ngspice/sm141064.ngspice cap_mim
.lib $::env(PDK_ROOT)/$::env(PDK)/libs.tech/ngspice/sm141064.ngspice mimcap_typical
"}
C {code.sym} 900 -300 0 0 {name=TB_SPLIT_CAL only_toplevel=true
value="
.param VDD=3.3 VCM=1.65 VREFP=3.3 VDIFF=0
.param CU='1.99e-3*25e-12+2.383e-10*20e-6'
* .temp = MIM model tnom (25 C): the PDK units then equal CU exactly, so the
* ideal sensitivity caps below are expressed in true Cu (tc1 = 14.6 ppm/K)
.temp 25
.param CPF_U=0 CPX_U=0 EPS_B=0
.param CPF='CPF_U*CU' CPX='CPX_U*CU' DCB='EPS_B*2*CU'
.model SWIDEAL SW VT=1.65 VH=0.05 RON=50 ROFF=1e12
* IDEAL behavioural switch: RON 50 ohm; ROFF 1e12 ohm represents the off-state
* leakage of a real 3.3 V switch (order of pA).  It is the only resistive path
* on the floating nodes besides the PDK MIM r_leak; no other resistors are added.
.options reltol=1e-9 abstol=1e-18 vntol=1e-12 method=gear
.save v(vcp) v(vcn) v(vfp) v(vfn) v(ainp) v(ainn)

.control
set noaskquit
set numdgt=12
shell rm -f split_cal_coef.txt split_cal_sar.txt split_cal_acq.txt
alterparam CPF_U=0
alterparam EPS_B=0
reset
* --- plate step coefficients ---
alter @v_bp9[pulse] = [ 1.65 3.3 30n 100p 100p 5n 2 ]
alter @v_bn9[pulse] = [ 1.65 3.3 30n 100p 100p 5n 2 ]
alter @v_bp8[pulse] = [ 1.65 3.3 40n 100p 100p 5n 2 ]
alter @v_bn8[pulse] = [ 1.65 3.3 40n 100p 100p 5n 2 ]
alter @v_bp7[pulse] = [ 1.65 3.3 50n 100p 100p 5n 2 ]
alter @v_bn7[pulse] = [ 1.65 3.3 50n 100p 100p 5n 2 ]
alter @v_bp6[pulse] = [ 1.65 3.3 60n 100p 100p 5n 2 ]
alter @v_bn6[pulse] = [ 1.65 3.3 60n 100p 100p 5n 2 ]
alter @v_bp5[pulse] = [ 1.65 3.3 70n 100p 100p 5n 2 ]
alter @v_bn5[pulse] = [ 1.65 3.3 70n 100p 100p 5n 2 ]
alter @v_bpr[pulse] = [ 1.65 3.3 80n 100p 100p 5n 2 ]
alter @v_bnr[pulse] = [ 1.65 3.3 80n 100p 100p 5n 2 ]
alter @v_bp4[pulse] = [ 1.65 3.3 90n 100p 100p 5n 2 ]
alter @v_bn4[pulse] = [ 1.65 3.3 90n 100p 100p 5n 2 ]
alter @v_bp3[pulse] = [ 1.65 3.3 100n 100p 100p 5n 2 ]
alter @v_bn3[pulse] = [ 1.65 3.3 100n 100p 100p 5n 2 ]
alter @v_bp2[pulse] = [ 1.65 3.3 110n 100p 100p 5n 2 ]
alter @v_bn2[pulse] = [ 1.65 3.3 110n 100p 100p 5n 2 ]
alter @v_bp1[pulse] = [ 1.65 3.3 120n 100p 100p 5n 2 ]
alter @v_bn1[pulse] = [ 1.65 3.3 120n 100p 100p 5n 2 ]
alter @v_bp0[pulse] = [ 1.65 3.3 130n 100p 100p 5n 2 ]
alter @v_bn0[pulse] = [ 1.65 3.3 130n 100p 100p 5n 2 ]
alter @v_bpd[pulse] = [ 1.65 3.3 140n 100p 100p 5n 2 ]
alter @v_bnd[pulse] = [ 1.65 3.3 140n 100p 100p 5n 2 ]
tran 20p 155n
