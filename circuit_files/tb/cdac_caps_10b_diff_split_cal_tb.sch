alter @v_bp5[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bn5[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bpr[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bnr[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bp4[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bn4[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bp3[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bn3[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bp2[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bn2[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bp1[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bn1[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bp0[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bn0[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bpd[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
alter @v_bnd[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
destroy all
alterparam CPF_U=0
alterparam EPS_B=0
reset
* --- acquisition, fine-node reset and charge retention ---
alterparam VDIFF=0.8
reset
tran 50p 2.05u
let _m = time ge 18n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let ip18 = v(ainp)[_i]
let _m = time ge 18n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let in18 = v(ainn)[_i]
let _m = time ge 18n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vcp18 = v(vcp)[_i]
let _m = time ge 18n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vcn18 = v(vcn)[_i]
let _m = time ge 18.5n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vfp18 = v(vfp)[_i]
let _m = time ge 18.5n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vfn18 = v(vfn)[_i]
let _m = time ge 21n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vcp21 = v(vcp)[_i]
let _m = time ge 21n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vcn21 = v(vcn)[_i]
let _m = time ge 21n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vfp21 = v(vfp)[_i]
let _m = time ge 21n
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vfn21 = v(vfn)[_i]
let _m = time ge 2.02u
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vcp2u = v(vcp)[_i]
let _m = time ge 2.02u
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vcn2u = v(vcn)[_i]
let _m = time ge 2.02u
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vfp2u = v(vfp)[_i]
let _m = time ge 2.02u
let _i = floor(length(time) - mean(_m)*length(_m) + 0.5)
let vfn2u = v(vfn)[_i]
let track_err_18n = (vcp18-vcn18) - (ip18-in18)
let hold_21n = vcp21-vcn21
let hold_2u = vcp2u-vcn2u
let droop_2us = hold_2u-hold_21n
let vfp_drift_2us = vfp2u-vfp21
let vfn_drift_2us = vfn2u-vfn21
echo ACQ VDIFF=0.8 > split_cal_acq.txt
print track_err_18n vfp18 vfn18 hold_21n hold_2u droop_2us >> split_cal_acq.txt
print vcp21 vcn21 vfp21 vfn21 vfp_drift_2us vfn_drift_2us >> split_cal_acq.txt
write split_cal_acq.raw v(vcp) v(vcn) v(vfp) v(vfn) v(ainp) v(ainn)
destroy all
alterparam VDIFF=0
reset
* --- SPICE-in-the-loop monotonic SAR (ideal sign comparator) ---
foreach vin 0.000151794 0.000455382 -0.000455382 1.553914443 -1.553914443 1.563477461 -1.563477461 1.649089236 -1.649089236 0.801016559 0.801927323 -0.801927323 -0.801016559 0.400280589 0.401191352 1.201752530 1.202663293 -1.202663293 -1.201752530 0.049636615 0.050547378 -0.050547378 -0.049636615 0.096692732 0.097603496 -0.097603496 -0.096692732 0.098210672 0.099121435 0.146784729 0.147695492 -0.147695492 -0.146784729 0.047359706 0.048270469 0.048877645 0.049788408 0.851108556 0.852019319 -0.852019319 -0.851108556 -1.288109614 -0.818187489 0.936583717 0.255420607 -1.261749080 -0.207890892 -0.065124149 -1.057783579
  let vpp = 1.65 + $vin/2
  let vnn = 1.65 - $vin/2
  alter @v_inp[dc] = $&vpp
  alter @v_inn[dc] = $&vnn
  alter @v_bp9[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn9[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bp8[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn8[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bp7[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn7[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bp6[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn6[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bp5[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn5[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bpr[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bnr[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bp4[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn4[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bp3[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn3[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bp2[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn2[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bp1[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn1[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bp0[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bn0[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bpd[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  alter @v_bnd[pulse] = [ 1.65 3.3 1 100p 100p 1 2 ]
  tran 50p 24n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b0 = 1
    alter @v_bn9[pulse] = [ 1.65 3.3 25n 100p 100p 1 2 ]
  else
    set b0 = 0
    alter @v_bp9[pulse] = [ 1.65 3.3 25n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 30n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b1 = 1
    alter @v_bn8[pulse] = [ 1.65 3.3 31n 100p 100p 1 2 ]
  else
    set b1 = 0
    alter @v_bp8[pulse] = [ 1.65 3.3 31n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 36n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b2 = 1
    alter @v_bn7[pulse] = [ 1.65 3.3 37n 100p 100p 1 2 ]
  else
    set b2 = 0
    alter @v_bp7[pulse] = [ 1.65 3.3 37n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 42n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b3 = 1
    alter @v_bn6[pulse] = [ 1.65 3.3 43n 100p 100p 1 2 ]
  else
    set b3 = 0
    alter @v_bp6[pulse] = [ 1.65 3.3 43n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 48n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b4 = 1
    alter @v_bn5[pulse] = [ 1.65 3.3 49n 100p 100p 1 2 ]
  else
    set b4 = 0
    alter @v_bp5[pulse] = [ 1.65 3.3 49n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 54n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b5 = 1
    alter @v_bnr[pulse] = [ 1.65 3.3 55n 100p 100p 1 2 ]
  else
    set b5 = 0
    alter @v_bpr[pulse] = [ 1.65 3.3 55n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 60n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b6 = 1
    alter @v_bn4[pulse] = [ 1.65 3.3 61n 100p 100p 1 2 ]
  else
    set b6 = 0
    alter @v_bp4[pulse] = [ 1.65 3.3 61n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 66n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b7 = 1
    alter @v_bn3[pulse] = [ 1.65 3.3 67n 100p 100p 1 2 ]
  else
    set b7 = 0
    alter @v_bp3[pulse] = [ 1.65 3.3 67n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 72n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b8 = 1
    alter @v_bn2[pulse] = [ 1.65 3.3 73n 100p 100p 1 2 ]
  else
    set b8 = 0
    alter @v_bp2[pulse] = [ 1.65 3.3 73n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 78n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b9 = 1
    alter @v_bn1[pulse] = [ 1.65 3.3 79n 100p 100p 1 2 ]
  else
    set b9 = 0
    alter @v_bp1[pulse] = [ 1.65 3.3 79n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 84n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b10 = 1
    alter @v_bn0[pulse] = [ 1.65 3.3 85n 100p 100p 1 2 ]
  else
    set b10 = 0
    alter @v_bp0[pulse] = [ 1.65 3.3 85n 100p 100p 1 2 ]
  end
  destroy all
  tran 50p 90n
  let vdd = v(vcp)[length(v(vcp))-1] - v(vcn)[length(v(vcn))-1]
  if vdd > 0
    set b11 = 1
  else
    set b11 = 0
  end
  destroy all
  echo SAR $vin $b0 $b1 $b2 $b3 $b4 $b5 $b6 $b7 $b8 $b9 $b10 $b11 >> split_cal_sar.txt
end
echo done
.endc
"}
C {title.sym} 160 0 0 0 {name=l1 author="Arjun Ananth"}
